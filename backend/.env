# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5001
HOST=0.0.0.0

# ============================================
# DATABASE CONFIGURATION
# ============================================
MONGODB_URI=mongodb+srv://saunnddryasr_db_user:<saunnddryasr_db_user>@cluster0.uo7rys6.mongodb.net/?appName=Cluster0
MONGODB_URI_PROD=mmongodb+srv://saunnddryasr_db_user:<saunnddryasr_db_user>@cluster0.uo7rys6.mongodb.net/?appName=Cluster0

# ============================================
# CORS CONFIGURATION - FRONTEND URLs
# ============================================
CORS_ORIGIN=https://construction-material-price-compari-six.vercel.app,
FRONTEND_URL=http://localhost:5173,
FRONTEND_URL_PROD=https://construction-material-price-compari-six.vercel.app
# .env (Root of frontend)
REACT_APP_API_URL=https://construction-material-price-compari-six.vercel.app/
# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your_super_secret_key_here_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_this_in_production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# ============================================
# SECURITY CONFIGURATION
# ============================================
